DATABASE_URL=postgres://stage:stage@localhost:5432/stageready
REDIS_URL=redis://localhost:6379
# S3-compatible storage. Local: MinIO from docker-compose. Production: R2 (S3_REGION=auto) or Backblaze B2
# (S3_ENDPOINT=https://s3.<region>.backblazeb2.com and S3_REGION=<region>, e.g. us-east-005).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=stage-ready
S3_REGION=us-east-1
S3_ACCESS_KEY=stage-ready
S3_SECRET_KEY=stage-ready-secret
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DEV_AUTH_BYPASS=true
# Production only: the app's public URL for Auth.js (or AUTH_TRUST_HOST=true behind a trusted proxy)
# AUTH_URL=https://app.example.com

# Meta Model API (https://dev.meta.ai/docs). With no key, every service runs on the mocked adapters (Demo Mode, no keys).
META_API_BASE_URL=https://api.meta.ai/v1
# Your key. MODEL_API_KEY (the name in Meta's provider config) is accepted too.
META_API_KEY=
# Muse Spark: fast work (claims, judges, slide and screen checks). Muse Wonder: long context (event pages, repos,
# the question bank and pre-pitch brief, Coach Notes); empty = use MODEL_SPARK.
MODEL_SPARK=muse-spark-1.3
MODEL_WONDER=muse-wonder-1.0
# Muse Image (title-card art) and SAM 3.1 (UI tracking), hosted on the same API
MODEL_IMAGE=muse-image-1.0
MODEL_SAM=sam-3.1
# API style: responses (POST /responses, recommended) or chat_completions
META_API_STYLE=responses
# Reasoning per model: none|minimal|low|medium|high|max. Spark serves live calls, so keep it low for speed
# (claim extraction always runs at minimal); Wonder does background work, so high is fine.
META_REASONING_EFFORT_SPARK=low
META_REASONING_EFFORT_WONDER=high
# Summary: auto|concise|detailed|none
META_REASONING_SUMMARY=auto
META_REASONING_ENCRYPTED=true
# How the adapter asks for JSON: json_schema (Meta's structured output), json_object, or none
META_RESPONSE_FORMAT=json_schema
# Force the mocked adapters even when a key is set.
MODEL_MOCK=false
# Model prices for session cost and the demo budget. Meta's published prices are built in (packages/ai/src/telemetry.ts,
# checked 2026-10-31: muse-spark-1.3 $1.25 in / $4.25 out, muse-wonder-1.0 $4 in / $20 out per 1M tokens);
# set JSON here only to override or add models: {"muse-spark-1.3": {"inputPerMTok": 1.25, "outputPerMTok": 4.25}}.
MODEL_PRICES=
# Demo Mode on the real models (scripted speech and fixtures stay): on by default when NODE_ENV=production.
# Real calls stop for the day at either cap, then Demo Mode answers with the mocks and says so.
DEMO_LIVE_MODELS=
DEMO_DAILY_BUDGET_USD=5
DEMO_DAILY_CALL_LIMIT=1500
# Guest demos per client IP per hour, counted in Redis (shared by every process, kept across restarts).
GUEST_LIMIT_PER_HOUR=30

# Speech to text (faster-whisper), take transcription, thumbnails and renders. Demo Mode needs none of it.
# The token is required in production, here and in the vision service's own environment.
VISION_SERVICE_URL=http://localhost:8000
VISION_SERVICE_TOKEN=
# Director: x264 preset for renders, and optional take score weights as JSON
FFMPEG_PRESET=veryfast
TAKE_SCORE_WEIGHTS=
REALTIME_URL=ws://localhost:4000
REALTIME_JWT_SECRET=replace-with-a-long-random-value
# Browser origin allowed to open realtime WebSockets
WEB_ORIGIN=http://localhost:3000

# Optional: OpenTelemetry traces (every model call carries prompt version, model ID, latency, tokens, cost)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Modal deploy only (deploy/modal/stage_ready.py), read at deploy time: one container stays warm unless
# KEEP_WARM=0; MODAL_REGION pins the container next to Postgres (e.g. us-east).
# KEEP_WARM=0
# MODAL_REGION=us-east
