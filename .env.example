DATABASE_URL=postgres://stage:stage@localhost:5432/stageready
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=stage-ready
S3_ACCESS_KEY=stage-ready
S3_SECRET_KEY=stage-ready-secret
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DEV_AUTH_BYPASS=true
# Production only: the app's public URL for Auth.js (or AUTH_TRUST_HOST=true behind a trusted proxy)
# AUTH_URL=https://app.example.com

# Meta Model API (https://dev.meta.ai/docs). With no key, every service runs on the mocked adapters (Demo Mode, no keys).
META_API_BASE_URL=https://api.meta.ai/v1
# Your key. MODEL_API_KEY (the name Meta's docs use) also works; META_API_KEY wins if both are set.
META_API_KEY=
MODEL_API_KEY=
# Muse Spark: fast, cheaper work (claims, judges, slide checks). muse-spark-1.3-contributor is cheaper but may train Meta models.
MODEL_SPARK=muse-spark-1.3
# Muse Wonder: long-context reasoning (event pages, repos, question bank, Coach Notes). Empty = use MODEL_SPARK.
MODEL_WONDER=muse-wonder-1.0
# Muse Image (image generation) and SAM 3.1 (UI tracking), hosted on the same API
MODEL_IMAGE=muse-image-1.0
MODEL_SAM=sam-3.1
MODEL_STT=            # leave empty: Muse Voice Transcribe has no word timestamps, so speech-to-text uses faster-whisper
MODEL_TTS=            # leave empty: no Meta text-to-speech; judges use the browser voice
EMBED_MODEL=          # leave empty: no Meta embedding model is listed
EMBED_DIM=            # fixed when the migration is generated (default 1024); regenerate if it changes
# API style: responses (POST /responses, recommended) or chat_completions
META_API_STYLE=responses
# Reasoning for the Responses API, per model: none|minimal|low|medium|high.
# Spark serves live calls (judges deciding when to interrupt, claim checks), so keep it low for speed.
# Wonder does background work (event pages, repos, question bank, Coach Notes), so high is fine.
META_REASONING_EFFORT_SPARK=low
META_REASONING_EFFORT_WONDER=high
# Summary: auto|concise|detailed|none
META_REASONING_SUMMARY=auto
META_REASONING_ENCRYPTED=true
# How the adapter asks for JSON: json_schema, json_object or none
META_RESPONSE_FORMAT=json_object
# Force the mocked adapters even when a key is set.
MODEL_MOCK=false
# Optional model prices for the per-session cost, JSON: {"<model id>": {"inputPerMTok": 0.5, "outputPerMTok": 1.5}}
MODEL_PRICES=
# Demo Mode on the real models (scripted speech and fixtures stay): on by default when NODE_ENV=production.
# Real calls stop for the day at either cap, then Demo Mode answers with the mocks and says so.
DEMO_LIVE_MODELS=
DEMO_DAILY_BUDGET_USD=5
DEMO_DAILY_CALL_LIMIT=1500

# Speech to text (faster-whisper) and SAM tracking. Demo Mode needs neither.
VISION_SERVICE_URL=http://localhost:8000
VISION_SERVICE_TOKEN=
# Director: x264 preset for renders, and optional take score weights as JSON
FFMPEG_PRESET=veryfast
TAKE_SCORE_WEIGHTS=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
REALTIME_URL=ws://localhost:4000
REALTIME_JWT_SECRET=replace-with-a-long-random-value
# Browser origin allowed to open realtime WebSockets
WEB_ORIGIN=http://localhost:3000

# Optional: OpenTelemetry traces (every model call carries prompt version, model ID, latency, tokens, cost)
OTEL_EXPORTER_OTLP_ENDPOINT=

# companion only
# Reserved for OBS scene switching, which is not built yet
OBS_WS_URL=ws://localhost:4455
OBS_WS_PASSWORD=
