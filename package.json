{
  "name": "stage-ready",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start --filter=@stage-ready/web --filter=@stage-ready/realtime --filter=@stage-ready/worker",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "db:generate": "pnpm --filter @stage-ready/db db:generate",
    "db:migrate": "pnpm --filter @stage-ready/db db:migrate",
    "db:seed": "pnpm --filter @stage-ready/db db:seed",
    "companion": "pnpm --filter @stage-ready/companion start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "ai:check": "pnpm --filter @stage-ready/ai check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
